{
  "name": "anyfontweight",
  "version": "0.1.0",
  "description": "Synthesize a font weight by moving glyph outlines along their medial axis",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
