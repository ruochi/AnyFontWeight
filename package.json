{
  "name": "anyfontweight",
  "version": "0.1.0",
  "description": "Synthesize a font weight by moving glyph outlines along their medial axis",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lab:analyze": "tsx lab/deform/analyze.ts",
    "lab:render": "tsx lab/deform/render.ts",
    "lab:check": "tsc -p lab"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "@types/clipper-lib": "^6.4.0",
    "clipper-lib": "^6.4.2",
    "flexlayer": "github:ruochi/flexlayer",
    "tsx": "^4.23.15",
    "typescript": "~5.4.2",
    "vitest": "^2.1.9"
  }
}
